{
    "version": 2,
    "builds": [
        {
            "src": "api/submit-signature.js",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/submit-signature",
            "dest": "/api/submit-signature"
        },
        {
            "src": "/(.*)",
            "dest": "/dist/$1"
        }
    ]
}